{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "echo",
      "type": "shell",
      "command": "echo",
      "args": ["status-bar-tasks"],
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "label": "$(play) echo",
          "detail": "Print a line in the terminal",
          "color": "#22C1D6",
          "running": {
            "label": "echoing",
            "icon": { "id": "sync~spin" }
          }
        }
      }
    },
    {
      "label": "hidden",
      "type": "shell",
      "command": "echo",
      "args": ["hidden"],
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "hide": true
        }
      }
    },
    {
      "label": "readme-only",
      "type": "shell",
      "command": "echo",
      "args": ["readme"],
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "label": "readme",
          "filePattern": "README\\.md$"
        }
      }
    },
    {
      "type": "npm",
      "script": "hello",
      "label": "npm hello",
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "icon": { "id": "package" }
        }
      }
    },
    {
      "type": "npm",
      "script": "hello",
      "path": "nested",
      "label": "npm nested",
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "icon": { "id": "folder" }
        }
      }
    },
    {
      "label": "server",
      "type": "shell",
      "command": "node",
      "args": [
        "-e",
        "setInterval(() => console.log('online'), 4000); console.log('listening')"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "statusbar": {
          "label": "$(server) server",
          "detail": "Long-running background task"
        }
      }
    }
  ]
}
