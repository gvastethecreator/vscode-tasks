{
  "name": "status-bar-tasks",
  "displayName": "Status Bar Tasks",
  "description": "Show VS Code workspace tasks as status bar buttons.",
  "version": "0.0.1",
  "packageManager": "pnpm@12.2.1",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-tasks/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-tasks#readme",
  "keywords": [
    "task",
    "tasks",
    "statusbar",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Tasks are disabled in Restricted Mode."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "statusBarTasks.run",
        "title": "Run Task from Status Bar",
        "category": "Status Bar Tasks"
      },
      {
        "command": "statusBarTasks.select",
        "title": "Run Task...",
        "category": "Status Bar Tasks"
      },
      {
        "command": "statusBarTasks.openPanel",
        "title": "Open Status Bar Tasks Settings",
        "category": "Status Bar Tasks"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "statusBarTasks.run",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "tasks.json",
        "url": "./schemas/tasks.json"
      },
      {
        "fileMatch": "*.code-workspace",
        "url": "./schemas/code-workspace.json"
      }
    ],
    "configuration": {
      "title": "Status Bar Tasks",
      "properties": {
        "tasks.statusbar.default.hide": {
          "type": "boolean",
          "default": false,
          "description": "Hide every task button unless the task sets options.statusbar.hide to false."
        },
        "tasks.statusbar.default.color": {
          "type": "string",
          "default": "",
          "description": "Default status bar foreground. Use a hex color or a theme color id. Empty uses the theme."
        },
        "tasks.statusbar.limit": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Maximum number of task buttons. Extra tasks move to the overflow Quick Pick. Null shows all."
        },
        "tasks.statusbar.compact": {
          "type": "boolean",
          "default": false,
          "description": "Hide task buttons and keep only the menu button on the status bar."
        },
        "tasks.statusbar.select.label": {
          "type": "string",
          "default": "...",
          "description": "Label for the overflow status bar item."
        },
        "tasks.statusbar.select.icon": {
          "type": "string",
          "default": "",
          "description": "Codicon id for the menu button, such as run-all or play. Empty uses run-all in compact mode and no icon otherwise."
        },
        "tasks.statusbar.select.color": {
          "type": "string",
          "default": "",
          "description": "Foreground for the overflow status bar item. Use a hex color or a theme color id."
        },
        "tasks.statusbar.running.indicator": {
          "type": "boolean",
          "default": true,
          "description": "Show a green bullet next to a task while it is running."
        },
        "tasks.statusbar.running.highlight": {
          "type": "boolean",
          "default": true,
          "description": "Use a warning background on a task while it is running."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
